{
  "uid": "knowledge-services",
  "title": "Knowledge service health",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape availability (unimplemented/stopped services remain down)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"knowledge-services\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(knowledge_http_requests_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Server failure ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(knowledge_http_requests_total{status=~\"5..\"}[5m])) / sum by (service) (rate(knowledge_http_requests_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP p95 duration (includes model/stream time; not local retrieval SLO)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(knowledge_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "title": "Model operations / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (rate(knowledge_domain_operations_total{component=\"model\",operation!=\"usage_commit\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data"
        }
      }
    },
    {
      "id": 6,
      "title": "Model operation p95 (includes queue, retries and durable usage)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(knowledge_domain_operation_duration_seconds_bucket{component=\"model\",operation!=\"usage_commit\"}[5m])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data",
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "title": "Ingest stage outcomes / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (rate(knowledge_domain_operations_total{component=\"ingest\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data"
        }
      }
    },
    {
      "id": 8,
      "title": "Projection outcomes / second (project and ACK are distinct)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service, operation, outcome) (rate(knowledge_domain_operations_total{component=\"projection\"}[5m]))",
          "legendFormat": "{{service}} {{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data"
        }
      }
    },
    {
      "id": 9,
      "title": "Authoritative state count (unknown/stale is not zero)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (service, queue) (knowledge_queue_size)",
          "legendFormat": "{{service}} {{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data"
        }
      }
    },
    {
      "id": 10,
      "title": "Queue snapshot known: 1=fresh, 0=unknown/stale",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "knowledge_queue_known",
          "legendFormat": "{{instance}} {{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data"
        }
      }
    },
    {
      "id": 11,
      "title": "Time since last successful queue snapshot",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "knowledge_queue_observed_age_seconds",
          "legendFormat": "{{instance}} {{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data",
          "unit": "s"
        }
      }
    },
    {
      "id": 12,
      "title": "Oldest known queued item / reconciliation overdue age",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (service, queue) (knowledge_queue_oldest_age_seconds)",
          "legendFormat": "{{service}} {{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data",
          "unit": "s"
        }
      }
    },
    {
      "id": 13,
      "title": "Observed acknowledged projection delivery p95 (not backlog)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(knowledge_projection_delivery_age_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data",
          "unit": "s"
        }
      }
    },
    {
      "id": 14,
      "title": "Successful local retrieval p95 (excludes embedding and reranking)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(knowledge_domain_operation_duration_seconds_bucket{component=\"retrieval\",operation=\"search_local\",outcome=\"success\"}[5m])))",
          "legendFormat": "Local retrieval",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data",
          "unit": "s"
        }
      }
    },
    {
      "id": 15,
      "title": "Retrieval stage p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(knowledge_domain_operation_duration_seconds_bucket{component=\"retrieval\",operation!~\"search|search_local\"}[5m])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data",
          "unit": "s"
        }
      }
    },
    {
      "id": 16,
      "title": "Graph traversal outcomes / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 61,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (rate(knowledge_domain_operations_total{component=\"graph\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown / no data"
        }
      }
    }
  ]
}
