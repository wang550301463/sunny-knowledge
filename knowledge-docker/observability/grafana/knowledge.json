{
  "uid": "knowledge-services",
  "title": "Knowledge service health",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Scrape availability (unimplemented/stopped services remain down)", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up{job=\"knowledge-services\"}", "legendFormat": "{{instance}}", "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "title": "Requests / second", "type": "timeseries", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (service) (rate(knowledge_http_requests_total[5m]))", "legendFormat": "{{service}}", "refId": "A"}]},
    {"id": 3, "title": "Server failure ratio", "type": "timeseries", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (service) (rate(knowledge_http_requests_total{status=~\"5..\"}[5m])) / sum by (service) (rate(knowledge_http_requests_total[5m]))", "legendFormat": "{{service}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}},
    {"id": 4, "title": "HTTP p95 duration (includes model/stream time; not local retrieval SLO)", "type": "timeseries", "gridPos": {"x": 0, "y": 13, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (service, le) (rate(knowledge_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}}
  ]
}
